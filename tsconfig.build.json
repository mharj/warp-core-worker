{
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "preserve",
    "target": "es2024",
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceRoot": "./src",
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "declaration": true,
    "removeComments": false,
    "inlineSources": true,
    "inlineSourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
  },
  "typedocOptions": {
    "entryPoints": ["src/index.ts"],
    "out": "docs"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
